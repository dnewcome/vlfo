# blitbomb squares as a node graph. Every literal below is also a knob:
# vlfo inputs graphs/squares.vlfo
in spread 60 0 400        # column spacing x 0.01, group A
in noise 0 -1 1           # from Pd: white noise every 100 ms
in offset -3 -8 8         # x of the first column, group A
in spread2 60 0 400
in offset2 1 -8 8
in showA 1 0 1
in showB 1 0 1

a = translate offset 0 | grid 5 6 (noise+spread)*0.01 1 | rect 0.3 0.1 | gray 0.5 | alpha showA
b = translate offset2 0 | grid 5 6 spread2*0.01 1 | rect 0.3 0.1 | gray 0.5 | alpha showB
