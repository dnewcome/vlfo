#N canvas 100 100 620 420 10;
#X text 20 10 vlfo first slice: two LFOs sent as OSC to /vlfo/speed and /vlfo/hue;
#X text 20 26 run: vlfo run shaders/vlfo-test.fs (listens on udp 9000);
#X obj 20 60 loadbang;
#X msg 20 85 connect localhost 9000;
#X obj 20 330 netsend -u -b;
#X msg 220 60 \; pd dsp 1;
#X obj 20 130 osc~ 0.1;
#X obj 20 155 *~ 1.5;
#X obj 20 180 +~ 2;
#X obj 20 215 snapshot~;
#X obj 120 190 metro 33;
#X obj 120 165 tgl 15 0 empty empty empty 17 7 0 10 -262144 -1 -1 1 1;
#X obj 20 250 oscformat vlfo speed;
#X obj 300 130 phasor~ 0.05;
#X obj 300 215 snapshot~;
#X obj 300 250 oscformat vlfo hue;
#X obj 120 140 loadbang;
#X text 60 130 speed: 0.5 .. 3.5 at 0.1 Hz;
#X text 360 130 hue: ramps 0..1 every 20 s;
#X connect 2 0 3 0;
#X connect 2 0 5 0;
#X connect 3 0 4 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 12 0;
#X connect 10 0 9 0;
#X connect 10 0 14 0;
#X connect 11 0 10 0;
#X connect 12 0 4 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 4 0;
#X connect 16 0 11 0;
