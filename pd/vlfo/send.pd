#N canvas 200 200 460 260 10;
#X obj 20 30 loadbang;
#X obj 20 60 f \$1;
#X msg 20 90 connect localhost \$1;
#X obj 20 170 netsend -u -b;
#X obj 220 120 r vlfo-osc;
#X obj 20 210 print vlfo-send;
#X text 120 30 [vlfo/send port] : one per patch. Collects every [vlfo/param] and sends it to vlfo's OSC port (9000 for run/serve \, 9001.. for ndi4);
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 5 0;
#X connect 4 0 3 0;
