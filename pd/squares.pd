#N canvas 100 100 760 460 10;
#X text 20 10 squares - control side of blitbomb scenes/squares.pd. The GEM drawing (two grids of 30 stamped rectangles) is now shaders/squares.fs \; everything that made it move is still here.;
#X text 20 42 run: make live SHADER=shaders/squares.fs PATCH=pd/squares.pd;
#X obj 20 80 vlfo/send 9000;
#X obj 20 120 loadbang;
#X msg 120 120 \; pd dsp 1;
#X obj 20 150 metro 100;
#X obj 90 150 noise~;
#X obj 20 180 snapshot~;
#X obj 20 210 vlfo/param noise;
#X text 20 240 glfo/control-noise 100: white noise sampled every 100 ms \, jitters the column spacing of group A;
#X obj 300 120 nbx 5 14 0 400 0 1 empty empty spread 0 -8 0 10 -262144 -1 -1 60 256;
#X obj 300 150 vlfo/param spread;
#X obj 420 120 nbx 5 14 -8 8 0 1 empty empty offset 0 -8 0 10 -262144 -1 -1 -3 256;
#X obj 420 150 vlfo/param offset;
#X obj 300 200 nbx 5 14 0 400 0 1 empty empty spread2 0 -8 0 10 -262144 -1 -1 60 256;
#X obj 300 230 vlfo/param spread2;
#X obj 420 200 nbx 5 14 -8 8 0 1 empty empty offset2 0 -8 0 10 -262144 -1 -1 1 256;
#X obj 420 230 vlfo/param offset2;
#X obj 560 120 tgl 15 1 empty empty showA 17 7 0 10 -262144 -1 -1 1 1;
#X obj 560 150 vlfo/param showA;
#X obj 560 200 tgl 15 1 empty empty showB 17 7 0 10 -262144 -1 -1 1 1;
#X obj 560 230 vlfo/param showB;
#X text 300 280 spread: column spacing x 0.01 (GEM units). offset: x of the first column. A is jittered by noise \, B is steady \, as in the original.;
#X obj 300 330 nbx 5 14 1 32 0 1 empty empty rows 0 -8 0 10 -262144 -1 -1 6 256;
#X obj 300 360 vlfo/param rows;
#X obj 420 330 nbx 5 14 1 32 0 1 empty empty cols 0 -8 0 10 -262144 -1 -1 5 256;
#X obj 420 360 vlfo/param cols;
#X obj 120 180 del 1000;
#X text 120 200 re-send the GUI values once vlfo and netsend are up;
#X msg 640 120 1;
#X msg 640 200 1;
#X connect 3 0 5 0;
#X connect 3 0 4 0;
#X connect 5 0 7 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
