#N canvas 100 100 1000 520 16;
#X text 20 10 squares - control side of blitbomb scenes/squares.pd;
#X text 20 32 the drawing is shaders/squares.fs \, the motion is still here;
#X text 20 54 make live SHADER=shaders/squares.fs PATCH=pd/squares.pd;
#X obj 20 100 vlfo/send 9000;
#X obj 20 160 loadbang;
#X msg 160 160 \; pd dsp 1;
#X obj 20 210 metro 100;
#X obj 130 210 noise~;
#X obj 20 260 snapshot~;
#X obj 20 310 vlfo/param noise;
#X text 20 350 noise: white noise every 100 ms (glfo/control-noise);
#X text 20 372 jitters the column spacing of group A;
#X obj 400 120 nbx 6 24 0 400 0 1 empty empty spread 0 -10 0 16 -262144 -1 -1 60 256;
#X obj 400 160 vlfo/param spread;
#X obj 600 120 nbx 6 24 -8 8 0 1 empty empty offset 0 -10 0 16 -262144 -1 -1 -3 256;
#X obj 600 160 vlfo/param offset;
#X obj 400 230 nbx 6 24 0 400 0 1 empty empty spread2 0 -10 0 16 -262144 -1 -1 60 256;
#X obj 400 270 vlfo/param spread2;
#X obj 600 230 nbx 6 24 -8 8 0 1 empty empty offset2 0 -10 0 16 -262144 -1 -1 1 256;
#X obj 600 270 vlfo/param offset2;
#X obj 800 120 tgl 24 1 empty empty showA 30 12 0 16 -262144 -1 -1 1 1;
#X obj 800 160 vlfo/param showA;
#X obj 800 230 tgl 24 1 empty empty showB 30 12 0 16 -262144 -1 -1 1 1;
#X obj 800 270 vlfo/param showB;
#X obj 400 340 nbx 6 24 1 32 0 1 empty empty rows 0 -10 0 16 -262144 -1 -1 6 256;
#X obj 400 380 vlfo/param rows;
#X obj 600 340 nbx 6 24 1 32 0 1 empty empty cols 0 -10 0 16 -262144 -1 -1 5 256;
#X obj 600 380 vlfo/param cols;
#X text 400 430 spread = column spacing x 0.01 (GEM units) \, offset = x of first column;
#X text 400 452 group A jitters with noise \, group B is steady \, as in the original;
#X obj 300 160 del 1000;
#X text 300 190 re-send GUI values once netsend is up;
