#N canvas 100 100 1180 600 10;
#X text 12 6 squares - control side of blitbomb scenes/squares.pd;
#X text 12 20 the drawing is shaders/squares.fs \, the motion is still here;
#X text 12 34 make live SHADER=shaders/squares.fs PATCH=pd/squares.pd;
#X obj 12 60 vlfo/send 9000;
#X obj 12 95 loadbang;
#X msg 95 95 \; pd dsp 1;
#X obj 12 125 metro 100;
#X obj 75 125 noise~;
#X obj 12 152 snapshot~;
#X obj 12 180 vlfo/param noise;
#X text 12 205 noise: white noise every 100 ms (glfo/control-noise);
#X text 12 218 jitters the column spacing of group A;
#X obj 230 72 nbx 5 14 0 400 0 1 empty empty spread 0 -8 0 10 -262144 -1 -1 60 256;
#X obj 230 95 vlfo/param spread;
#X obj 340 72 nbx 5 14 -8 8 0 1 empty empty offset 0 -8 0 10 -262144 -1 -1 -3 256;
#X obj 340 95 vlfo/param offset;
#X obj 230 135 nbx 5 14 0 400 0 1 empty empty spread2 0 -8 0 10 -262144 -1 -1 60 256;
#X obj 230 158 vlfo/param spread2;
#X obj 340 135 nbx 5 14 -8 8 0 1 empty empty offset2 0 -8 0 10 -262144 -1 -1 1 256;
#X obj 340 158 vlfo/param offset2;
#X obj 450 72 tgl 15 1 empty empty showA 17 7 0 10 -262144 -1 -1 1 1;
#X obj 450 95 vlfo/param showA;
#X obj 450 135 tgl 15 1 empty empty showB 17 7 0 10 -262144 -1 -1 1 1;
#X obj 450 158 vlfo/param showB;
#X obj 230 198 nbx 5 14 1 32 0 1 empty empty rows 0 -8 0 10 -262144 -1 -1 6 256;
#X obj 230 221 vlfo/param rows;
#X obj 340 198 nbx 5 14 1 32 0 1 empty empty cols 0 -8 0 10 -262144 -1 -1 5 256;
#X obj 340 221 vlfo/param cols;
#X text 230 250 spread = column spacing x 0.01 (GEM units);
#X text 230 264 offset = x of the first column;
#X text 230 278 A jitters with noise \, B is steady (as in the original);
#X obj 170 95 del 1000;
#X text 120 232 del 1000: re-send the GUI values once netsend is up;
